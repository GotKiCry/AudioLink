{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AudioLink",
  "version": "0.1.1",
  "identifier": "com.gotkicry.audiolink",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AudioLink",
        "width": 1100,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#1C1C1C"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../../docs/compliance/THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md" },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/GotKiCry/AudioLink/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NjdFMzUxQTdCMUNFNzMKUldSenpyR25VZU5uSkxxZ0YyL0J0ZDNwckxMUm5Ta0swa2M5V2VOR0NlTEhYeG9XRmxJUFhva0IK"
    }
  }
}
