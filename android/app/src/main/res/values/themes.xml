<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      XML 主题仅用于窗口外壳（windowBackground / 系统栏）；实际配色由 Compose Material3
      （ui/theme/Theme.kt）接管，两边不重复定义颜色。

      2026-09-18 对齐（承接 DESIGN.md §Shapes「Android 落点」与 §Colors）：
      1) 系统栏一律 **transparent + 不做对比度 scrim**。App 自己画到边（edge-to-edge），
         底下的颜色只该来自 surfaceContainer / background —— 系统再叠一层 scrim 就会
         在屏幕边缘出现一条不属于本设计语言的颜色带。
         （注意：这不是「屏幕底部浅灰横带」的成因 —— 那条横带查实为被屏幕底边裁切的
          禁用态主按钮，见 ui/components/AlControls.kt 的 alButtonColors 注释。）
      2) windowBackground 保持 transparent：Compose 的 Scaffold 会铺满整屏，
         窗口底只在冷启动的第一帧可见，用透明比用一张写死的纯色更安全
         （写死纯色就会在另一种光照下闪一下相反的颜色）。
      3) parent 仍是 Light：它只影响**系统栏图标的默认深浅**与少数装饰默认值，
         而这两个值已经由 MainActivity 的 enableEdgeToEdge(...) 按 App 主题显式接管。
         换成 DayNight 会把 minSdk 26 上的行为交给厂商 ROM 决定，不如自己写明。

      enforce* 两个属性是 API 29 引入的：API 26–28 上 framework 不认识、直接忽略，
      行为与不写这一行完全相同；用 tools:targetApi 把这个事实讲给 lint 听，
      而不是把它塞进 values-v29（style 变体是**整体替换**而非合并，拆出去要复写全部 item）。
    -->
    <style name="Theme.AudioLink" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- 系统栏：透明 + 明确关闭对比度 scrim -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- MediaProjection 授权中转页：透明、无标题栏 -->
    <style name="Theme.AudioLink.Transparent" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
