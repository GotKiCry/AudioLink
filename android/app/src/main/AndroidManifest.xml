<?xml version="1.0" encoding="utf-8"?>
<!--
  AudioLink Android 清单
  与旧版的刻意差异：
   1) 不声明 usesCleartextTraffic（全链路 QUIC/TLS，禁止明文）
   2) 不内置任何 HTTP 服务器 → 无网络攻击面
   3) 不做开机自启（用户决策）：Android 15+ 已禁止由 BOOT_COMPLETED 启动 mediaPlayback
      前台服务，且本项目不需要该能力 → 不申请 RECEIVE_BOOT_COMPLETED、不注册 BootReceiver
   4) 前台服务启动即进入前台（startForegroundService），声明 mediaPlayback|connectedDevice
      两个无超时类型（后者用于局域网设备连接场景，零运行时成本）
   5) 通知动作使用显式 Intent（旧版 PendingIntent 指向 BroadcastReceiver 导致点击崩溃）
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 局域网通信 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 接收页面在前台扫描时持有 WifiManager.MulticastLock，以接收 LAN 广播；离开页面释放。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- 前台服务与通知（Android 13+ 需运行时授权 POST_NOTIFICATIONS） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 可选发送源：麦克风（运行时按需申请，FR-07）；系统内录走 MediaProjection 授权，无需额外声明 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 采集所需的前台服务类型权限（Android 14 / API 34 起，FGS 类型必须与对应权限成对声明）：
         * FOREGROUND_SERVICE_MICROPHONE —— 麦克风采集（FR-07）；
         * FOREGROUND_SERVICE_MEDIA_PROJECTION —— 系统内录（FR-06）；系统还要求**先进入该类型前台服务再取投影**。
         ⚠️ [M5] 上架合规待办（本清单不自行裁定，列出待 Lead 记账）：
           1) Play 控制台对 microphone 前台服务要求填写用途声明与审核说明；
           2) mediaProjection 前台服务需说明录制范围与用户可见提示；
           3) microphone 类型不允许在无用户可见提示的情况下长期后台采集。
         本轮只加这两个「采集真的必需」的权限，未新增其它任何权限。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 应用内更新（M5）：把校验过签名的更新包交给系统安装器。
         Android 8+ 起这是**按应用**授权的权限，首次安装时系统会弹「安装未知应用」引导页；
         本应用只把自己签名的包交给安装器（见 update/ApkSignature.kt），不用于任何其它分发。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".AudioLinkApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioLink">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 内录授权结果回传（MediaProjection） -->
        <activity
            android:name=".capture.MediaProjectionRequestActivity"
            android:exported="false"
            android:theme="@style/Theme.AudioLink.Transparent" />

        <!-- 核心前台服务：接收播放 + 发送采集。
             mediaPlayback|connectedDevice 两个类型均无时长上限，且 media3 MediaSessionService
             的媒体通知可豁免 POST_NOTIFICATIONS 拒绝（用户拒绝通知权限时仍能显示播放通知）。

             microphone|mediaProjection 是 FR-06/07 的采集两条路（本轮补）：
             * microphone —— 麦克风采集期间必须处于该类型前台服务（Android 14+ 强制）；
             * mediaProjection —— 系统内录**取投影之前**就必须已经进入该类型前台服务，
               所以顺序是 startForeground(含 mediaProjection) → getMediaProjection → 采集。
             服务始终是前台服务，这两个类型只在采集时用得上，不增加常驻开销。 -->
        <service
            android:name=".service.AudioLinkService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|connectedDevice|microphone|mediaProjection" />

        <!-- 应用内更新的交接口：把下载好的 APK 以 content:// 交给系统安装器。
             API 24+ 禁止 file:// 跨应用传递（FileUriExposedException），所以必须走 provider。
             暴露范围只有 filesDir/updates/（见 res/xml/update_file_paths.xml）；
             authority 用 ${applicationId} 展开，debug 与 release 各自独立，不会互相串。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
    </application>
</manifest>
