# ---------- Rust ----------
/target/
**/target/
# Android 交叉编译独立产物目录（避免与桌面 target 互相触发重编）
/target-android/
core/target/
desktop/src-tauri/target/
*.rs.bk
Cargo.lock.orig

# ---------- Node / Tauri ----------
node_modules/
dist/
dist-ssr/
.vite/
desktop/dist/
desktop/node_modules/
pnpm-lock.yaml.bak
# Tauri 每次构建自动生成的权限 schema（不入库）
desktop/src-tauri/gen/schemas/

# ---------- Android ----------
android/.gradle/
android/.kotlin/               # Kotlin 增量编译的会话/缓存目录
android/.gradle-home/          # 本项目隔离的 GRADLE_USER_HOME（避免混入全局私服凭据）
.gradle-home/
android/build/
android/app/build/
android/local.properties
# 发布签名口令（PUBLIC 仓库绝对不入库）；注意 .gitignore 不支持行尾注释
android/keystore.properties
android/.idea/
android/captures/
android/*.apk
android/*.aab
*.jks
*.keystore
android/app/release/
android/.cxx/
android/app/src/main/jniLibs/
!android/app/src/main/jniLibs/.gitkeep

# ---------- 密钥与身份（绝不入库）----------
*.pem
*.key
identity/
secrets/
.env
.env.*
!.env.example

# ---------- 日志与产物 ----------
/out/
logs/
*.log
*.csv
*.zip
!/docs/**/*.md

# ---------- 设计过程产物 ----------
# Impeccable 的工作目录（截图 / 决策页 / A-B 对照）：过程物，不进仓库。
# 设计规范与可运行样张在 docs/design/ 下 —— 那些是长期资产，要入库。
.impeccable/
.tmp-shots/

# ---------- IDE / OS ----------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
